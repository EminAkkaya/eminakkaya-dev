---
// Tema seçici: Sistem → Açık → Koyu döngüsü. Seçim localStorage('theme') içinde,
// <html data-theme> ile uygulanır; ilk boyama öncesi Base.astro'daki inline script uygular.
// JS kapalıysa düğme gizli kalır, site sistem tercihini izler.
import Icon from './Icon.astro';
interface Props { lang?: 'tr' | 'en' }
const { lang = 'tr' } = Astro.props;
const label = lang === 'en' ? 'Theme: system. Switch to light' : 'Tema: Sistem. Açık temaya geç';
---

<button type="button" class="theme-toggle" data-theme-toggle data-choice="system" aria-label={label} title={label} hidden>
  <span data-icon="system"><Icon name="monitor" size={20} /></span>
  <span data-icon="light"><Icon name="sun" size={20} /></span>
  <span data-icon="dark"><Icon name="moon" size={20} /></span>
</button>

<script>
  type Choice = 'system' | 'light' | 'dark';
  const KEY = 'theme';
  const ORDER: Choice[] = ['system', 'light', 'dark'];
  const en = document.documentElement.lang === 'en';
  // Erişilebilir ad: şu anki seçim + tıklayınca ne olacağı.
  const LABELS: Record<Choice, string> = en
    ? { system: 'Theme: system. Switch to light', light: 'Theme: light. Switch to dark', dark: 'Theme: dark. Switch to system' }
    : { system: 'Tema: Sistem. Açık temaya geç', light: 'Tema: Açık. Koyu temaya geç', dark: 'Tema: Koyu. Sistem temasına geç' };
  // Tarayıcı çubuğu renkleri Base.astro'daki theme-color meta'larından okunur (ham hex burada yok).
  const metas = [...document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')];
  metas.forEach((m) => { m.dataset.own ??= m.content; });
  const colorFor = (scheme: 'light' | 'dark') =>
    metas.find((m) => m.media.includes(scheme))?.dataset.own ?? '';

  const read = (): Choice => {
    try {
      const v = localStorage.getItem(KEY);
      return v === 'light' || v === 'dark' ? v : 'system';
    } catch {
      return 'system';
    }
  };

  const apply = (choice: Choice) => {
    const root = document.documentElement;
    if (choice === 'system') delete root.dataset.theme;
    else root.dataset.theme = choice;
    // Tarayıcı çubuğu rengi seçime uysun; sistemde media sorgulu ilk değerlere döner.
    metas.forEach((m) => {
      m.content = (choice === 'system' ? m.dataset.own : colorFor(choice)) ?? m.content;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      const text = LABELS[choice];
      btn.dataset.choice = choice;
      btn.setAttribute('aria-label', text);
      btn.title = text;
    });
  };

  apply(read());
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const cur = (btn.dataset.choice as Choice) ?? 'system';
      const next = ORDER[(ORDER.indexOf(cur) + 1) % ORDER.length];
      try {
        if (next === 'system') localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, next);
      } catch {
        /* depolama kapalı: yalnız bu sayfada uygulanır */
      }
      apply(next);
    });
  });
</script>

<style>
  @layer blocks {
    .theme-toggle:not([hidden]) {
      display: inline-grid;
      place-items: center;
      width: var(--tap);
      height: var(--tap);
      padding: 0;
      border: 1px solid transparent;
      border-radius: var(--radius-control);
      background: transparent;
      color: var(--text-secondary);
      cursor: pointer;
      transition: transform var(--duration-fast) var(--ease);
    }
    .theme-toggle:hover { color: var(--text); background: var(--bg-hover); }
    .theme-toggle:active { transform: translateY(1px); }
    .theme-toggle [data-icon] { display: none; }
    .theme-toggle[data-choice='system'] [data-icon='system'],
    .theme-toggle[data-choice='light'] [data-icon='light'],
    .theme-toggle[data-choice='dark'] [data-icon='dark'] { display: block; }
  }
</style>
