---
// Tema düğmesi: Açık ↔ Koyu. Seçim localStorage('theme') içinde, <html data-theme> ile uygulanır.
// İlk boyamadan önce Base.astro'daki inline script uygular (kayıt yoksa cihaz tercihi).
// JS kapalıysa düğme gizli kalır, site cihaz tercihini izler.
import Icon from './Icon.astro';
interface Props { lang?: 'tr' | 'en' }
const { lang = 'tr' } = Astro.props;
const label = lang === 'en' ? 'Switch to dark theme' : 'Koyu temaya geç';
---

<button type="button" class="theme-toggle" data-theme-toggle data-choice="light" aria-label={label} title={label} hidden>
  <span data-icon="light"><Icon name="moon" size={20} /></span>
  <span data-icon="dark"><Icon name="sun" size={20} /></span>
</button>

<script>
  type Choice = 'light' | 'dark';
  const KEY = 'theme';
  const en = document.documentElement.lang === 'en';
  // Erişilebilir ad, tıklayınca ne olacağını söyler; ikon da gidilecek temayı gösterir.
  const LABELS: Record<Choice, string> = en
    ? { light: 'Switch to dark theme', dark: 'Switch to light theme' }
    : { light: 'Koyu temaya geç', dark: 'Açık temaya geç' };
  // Tarayıcı çubuğu renkleri Base.astro'daki theme-color meta'larından okunur (ham hex burada yok).
  const metas = [...document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')];
  metas.forEach((m) => { m.dataset.own ??= m.content; });
  const colorFor = (scheme: Choice) => metas.find((m) => m.media.includes(scheme))?.dataset.own ?? '';

  const current = (): Choice => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');

  const apply = (choice: Choice) => {
    document.documentElement.dataset.theme = choice;
    metas.forEach((m) => { m.content = colorFor(choice) || m.content; });
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.dataset.choice = choice;
      btn.setAttribute('aria-label', LABELS[choice]);
      btn.title = LABELS[choice];
    });
  };

  apply(current());
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const next: Choice = current() === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem(KEY, next);
      } catch {
        /* depolama kapalı: yalnız bu sayfada uygulanır */
      }
      apply(next);
    });
  });
</script>

<style>
  @layer blocks {
    .theme-toggle:not([hidden]) {
      display: inline-grid;
      place-items: center;
      width: var(--tap);
      height: var(--tap);
      padding: 0;
      border: 1px solid transparent;
      border-radius: var(--radius-control);
      background: transparent;
      color: var(--text-secondary);
      cursor: pointer;
      transition: transform var(--duration-fast) var(--ease);
    }
    .theme-toggle:hover { color: var(--text); background: var(--bg-hover); }
    .theme-toggle:active { transform: translateY(1px); }
    .theme-toggle [data-icon] { display: none; }
    .theme-toggle[data-choice='light'] [data-icon='light'],
    .theme-toggle[data-choice='dark'] [data-icon='dark'] { display: block; }
  }
</style>
