---
// Lucide ikonları, 1.5px çizgi (tasarım sistemi §6). Dekoratif ise aria-hidden.
import MessageCircle from '@lucide/astro/icons/message-circle';
import Mail from '@lucide/astro/icons/mail';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import CircleCheck from '@lucide/astro/icons/circle-check';
import FlaskConical from '@lucide/astro/icons/flask-conical';
import Hourglass from '@lucide/astro/icons/hourglass';
import CodeXml from '@lucide/astro/icons/code-xml';
import FileSpreadsheet from '@lucide/astro/icons/file-spreadsheet';
import Receipt from '@lucide/astro/icons/receipt';
import Smartphone from '@lucide/astro/icons/smartphone';
import AppWindow from '@lucide/astro/icons/app-window';
import PhoneCall from '@lucide/astro/icons/phone-call';
import Wrench from '@lucide/astro/icons/wrench';
import LifeBuoy from '@lucide/astro/icons/life-buoy';
import MapPin from '@lucide/astro/icons/map-pin';
import ClipboardList from '@lucide/astro/icons/clipboard-list';
import DatabaseBackup from '@lucide/astro/icons/database-backup';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import ChartNoAxesColumn from '@lucide/astro/icons/chart-no-axes-column';
import Hammer from '@lucide/astro/icons/hammer';
import Quote from '@lucide/astro/icons/quote';
import Play from '@lucide/astro/icons/play';
import Monitor from '@lucide/astro/icons/monitor';
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';
import X from '@lucide/astro/icons/x';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';

const icons = {
  'message-circle': MessageCircle,
  mail: Mail,
  'arrow-right': ArrowRight,
  'arrow-left': ArrowLeft,
  'arrow-up-right': ArrowUpRight,
  'circle-check': CircleCheck,
  'flask-conical': FlaskConical,
  hourglass: Hourglass,
  'code-xml': CodeXml,
  'file-spreadsheet': FileSpreadsheet,
  receipt: Receipt,
  smartphone: Smartphone,
  'app-window': AppWindow,
  'phone-call': PhoneCall,
  wrench: Wrench,
  'life-buoy': LifeBuoy,
  'map-pin': MapPin,
  'clipboard-list': ClipboardList,
  'database-backup': DatabaseBackup,
  'shield-check': ShieldCheck,
  'chevron-down': ChevronDown,
  chart: ChartNoAxesColumn,
  hammer: Hammer,
  quote: Quote,
  play: Play,
  monitor: Monitor,
  sun: Sun,
  moon: Moon,
  x: X,
  'chevron-left': ChevronLeft,
  'chevron-right': ChevronRight,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
const Cmp = icons[name];
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<Cmp size={size} stroke-width={1.5} class={className} {...a11y} />
