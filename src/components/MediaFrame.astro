---
// Görsel varsa gösterir; yoksa düz renkli, sakin bir yer tutucu (proje adının baş harfi).
interface Props {
  src: string | null;
  alt: string;
  title: string;
  ratio?: string;
  eager?: boolean;
  sizes?: string;
}
const { src, alt, title, ratio = '16 / 10', eager = false } = Astro.props;
const initial = title.trim().charAt(0).toLocaleUpperCase('tr');
---

<div class="media-frame" style={`aspect-ratio: ${ratio}`}>
  {src ? (
    <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" width="1600" height="1000" />
  ) : (
    <div class="media-frame__ph" role="img" aria-label={`${title}: görsel hazırlanıyor`}>
      <span aria-hidden="true">{initial}</span>
    </div>
  )}
</div>

<style>
  @layer blocks {
    .media-frame {
      overflow: hidden;
      border-radius: var(--radius-control);
      background: var(--bg-subtle);
      border: 1px solid var(--border);
    }
    .media-frame img { width: 100%; height: 100%; object-fit: cover; }
    .media-frame__ph {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      color: var(--text-secondary);
      font-size: clamp(2rem, 6vw, 3rem);
      font-weight: 600;
      letter-spacing: var(--tracking-tight);
    }
  }
</style>
