      <ul class="cluster mt-5" role="list">
        <li><a class="btn" data-variant="primary" href="/">Ana sayfaya dön</a></li>
        <li><a class="btn" data-variant="ghost" href="/calismalar">Çalışmalara bak</a></li>
      </ul>
    </div>
  </section>
</Base>
