---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ContactButton from '../../components/ContactButton.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import DemoVideo from '../../components/DemoVideo.astro';
import Icon from '../../components/Icon.astro';
import { getProjects, type Project } from '../../lib/projects';
import { projectMedia } from '../../lib/media';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

interface Props { project: Project; prev: Project | null; next: Project | null }
const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const media = projectMedia(d.slug, d.title, d);
const shots = media.shots;
// Galeri satırları boş kalmasın: 3'e bölünüyorsa 3 sütun, değilse 2 sütun (tekse son görsel tam satır).
const shotCols = shots.length % 3 === 0 ? 3 : 2;
---

<Base title={d.title} description={`${d.headline}. ${d.summary}`} ogType="article">
  <article>
    <header class="section case-head">
      <div class="container">
        <nav aria-label="Konum" class="crumbs small">
          <a href="/calismalar">Çalışmalar</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{d.title}</span>
        </nav>
        <h1 class="case-title">{d.headline}</h1>
        <p class="lead measure mt-4">{d.summary}</p>

        <dl class="facts">
          <div><dt>Proje</dt><dd>{d.title}</dd></div>
          <div><dt>Sektör</dt><dd>{d.sector}</dd></div>
          {d.period && <div><dt>Süre</dt><dd>{d.period}</dd></div>}
          <div><dt>Şu an</dt><dd><StatusBadge status={d.status} /></dd></div>
        </dl>

        {d.metrics.length > 0 && (
          <ul class="metrics" role="list">
            {d.metrics.map((m) => (
              <li><span class="metrics__value">{m.value}</span><span class="metrics__label">{m.label}</span></li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <div class="container case-media">
      {media.demo ? (
        <DemoVideo demo={media.demo} label={`${d.title}: kısa ekran kaydı (sahte veriyle)`} />
      ) : (
        <MediaFrame src={media.cover} alt={`${d.title} ekranından bir görünüm`} title={d.title} eager />
      )}
    </div>

    <div class="container case-story">
      <div class="prose">
        <Content />
      </div>

      <aside class="case-aside" aria-label="Özet">
        {d.quote && (
          <figure class="aside-card case-quote">
            <Icon name="quote" size={22} class="case-quote__icon" />
            <blockquote><p>{d.quote.text}</p></blockquote>
            <figcaption class="small muted">{d.quote.author}</figcaption>
          </figure>
        )}
        {d.tech.length > 0 && (
          <div class="aside-card">
            <h2 class="aside-title">Kullanılanlar</h2>
            <ul class="cluster tech__tags" role="list" aria-label="Kullanılan teknolojiler">
              {d.tech.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </div>
        )}
        <section class="aside-card case-cta" aria-labelledby="benzer">
          <h2 id="benzer" class="aside-title">Benzer bir derdiniz mi var?</h2>
          <p class="muted small">Bugün işin nasıl yapıldığını kısaca anlatın; nasıl kolaylaşabileceğini birlikte konuşalım.</p>
          <ContactButton size="sm" />
        </section>
      </aside>
    </div>

    <div class="container case-body">
      {shots.length > 0 && (
        <section class="shots" aria-labelledby="ekranlar">
          <h2 id="ekranlar">Ekranlar</h2>
          <p class="small muted">Görüntüler sahte (örnek) veriyle hazırlandı.</p>
          <div class="shots__grid" data-cols={shotCols} style={`--shot-cols: ${shotCols}`}>
            {shots.map((s) => (
              <figure>
                <a href={s.src} class="shots__link" data-lightbox={`shots-${d.slug}`}>
                  <img src={s.src} alt={s.alt} loading="lazy" decoding="async" width={s.w} height={s.h} />
                </a>
                <figcaption class="small muted">{s.alt}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      {d.links.length > 0 && (
        <ul class="cluster case-links" role="list">
          {d.links.map((l) => (
            <li>
              <a class="btn" data-variant="ghost" href={l.href} target="_blank" rel="noopener">
                {l.label} <Icon name="arrow-up-right" size={16} />
                <span class="visually-hidden"> (yeni sekmede açılır)</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {d.techDetails.length > 0 && (
        <details class="disclosure tech">
          <summary>
            <span>Teknik detaylar</span>
            <Icon name="chevron-down" size={18} />
          </summary>
          <div class="disclosure__body">
            {d.techDetails.length > 0 && (
              <ul class="tech__list">
                {d.techDetails.map((t) => <li>{t}</li>)}
              </ul>
            )}
          </div>
        </details>
      )}

    </div>
  </article>

  <nav class="container pager" aria-label="Diğer çalışmalar">
    {prev ? (
      <a class="pager__link" href={`/calismalar/${prev.data.slug}`} rel="prev">
        <span class="small muted"><Icon name="arrow-left" size={14} /> Önceki</span>
        <span>{prev.data.title}</span>
      </a>
    ) : null}
    {next ? (
      <a class="pager__link pager__link--next" href={`/calismalar/${next.data.slug}`} rel="next">
        <span class="small muted">Sonraki <Icon name="arrow-right" size={14} /></span>
        <span>{next.data.title}</span>
      </a>
    ) : null}
  </nav>
</Base>

<style>
  @layer blocks {
    .case-head { padding-bottom: var(--space-6); }
    .crumbs { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; color: var(--text-secondary); margin-bottom: var(--space-4); }
    .crumbs a { display: inline-flex; align-items: center; min-height: var(--tap); }
    .case-title { font-size: var(--fs-hero); line-height: 1.12; max-width: 24ch; }

    .facts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr));
      gap: var(--space-4);
      margin-top: var(--space-6);
      padding: var(--space-5);
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
    }
    .facts dt {
      font-size: var(--fs-xs);
      font-weight: 500;
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      color: var(--text-secondary);
      margin-bottom: var(--space-1);
    }
    .facts dd { font-weight: 500; }

    .metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr));
      gap: var(--space-4);
      list-style: none;
      padding: 0;
      margin-top: var(--space-4);
    }
    .metrics li { display: grid; gap: var(--space-1); }
    .metrics__value { font-size: 1.625rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    .metrics__label { font-size: var(--fs-sm); color: var(--text-secondary); }

    .case-media { margin-bottom: var(--space-7); }
    .case-media > * { max-width: 960px; }

    .case-story { display: grid; gap: var(--space-6); margin-bottom: var(--space-7); }
    .case-story .prose :global(h2:first-child) { margin-top: 0; }
    @media (min-width: 1024px) {
      .case-story { grid-template-columns: minmax(0, 1fr) 340px; gap: var(--space-8); align-items: start; }
      .case-aside { position: sticky; top: var(--space-5); }
    }
    .case-aside { display: grid; gap: var(--space-4); }
    .aside-card {
      display: grid;
      gap: var(--space-3);
      justify-items: start;
      padding: var(--space-5);
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-card);
    }
    .aside-title { font-size: var(--fs-base); }
    .case-quote :global(.case-quote__icon) { color: var(--accent); }
    .case-quote blockquote { font-size: var(--fs-md); line-height: 1.5; }

    .case-body { display: grid; gap: var(--space-7); }

    .shots > * + * { margin-top: var(--space-2); }
    .shots__grid {
      display: grid;
      gap: var(--space-4);
      grid-template-columns: 1fr;
      margin-top: var(--space-4);
    }
    @media (min-width: 640px) {
      .shots__grid { grid-template-columns: repeat(var(--shot-cols, 2), minmax(0, 1fr)); }
      .shots__grid > figure:last-child:nth-child(odd) { grid-column: 1 / -1; }
      .shots__grid > figure:last-child:nth-child(odd) img { max-height: 420px; object-fit: cover; object-position: top center; }
      .shots__grid[data-cols='3'] > figure:last-child:nth-child(odd) { grid-column: auto; }
    }
    .shots figure { display: grid; gap: var(--space-2); }
    .shots__link { display: block; border-radius: var(--radius-control); cursor: zoom-in; }
    .shots img {
      width: 100%;
      border-radius: var(--radius-control);
      border: 1px solid var(--border);
      background: var(--bg-subtle);
    }

    .tech__tags { --cluster-space: var(--space-2); list-style: none; padding: 0; }
    .tech__list { padding-inline-start: 1.15rem; display: grid; gap: var(--space-2); color: var(--text-secondary); }
    .tech__list li::marker { color: var(--accent); }


    .pager {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
      gap: var(--space-4);
      margin-top: var(--space-7);
    }
    .pager__link {
      display: grid;
      gap: var(--space-1);
      min-height: var(--tap);
      padding: var(--space-4);
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
      background: var(--bg-card);
      color: var(--text);
      text-decoration: none;
      font-weight: 600;
    }
    .pager__link:hover { background: var(--bg-hover); color: var(--text); }
    .pager__link .small { display: inline-flex; align-items: center; gap: var(--space-1); font-weight: 500; }
    .pager__link--next { text-align: end; justify-items: end; }
  }
</style>
